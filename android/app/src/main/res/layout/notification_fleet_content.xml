<?xml version="1.0" encoding="utf-8"?>
<!--
  Shade / collapsed tray body only.
  Left Karins logo + "Karins Fleet" app name come from DecoratedCustomViewStyle
  + setLargeIcon — that is the OEM-reliable left slot. Putting another logo
  inside this view stole width and caused double-chrome / blank avatars on
  some skins when the RemoteViews bitmap failed to parcel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/notif_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_body"
        style="@style/TextAppearance.Compat.Notification.Info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:lineSpacingExtra="1dp"
        android:maxLines="6"
        android:paddingTop="2dp"
        android:textSize="13sp" />
</LinearLayout>
