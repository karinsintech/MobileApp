<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep tray / FCM resources that R8 optimized shrinking cannot see from JS strings.
  Missing ic_stat_notification causes a hard native crash on many OEM phones when
  Notifee/FCM posts the first alert after login.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_notification,@font/audiowide" />
