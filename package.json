{
  "name": "KarinsFleet",
  "version": "2.1.5",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "kill-port": "node scripts/kill-metro-port.js",
    "android": "node scripts/kill-metro-port.js && node scripts/run-android.js",
    "ios": "react-native run-ios",
    "start": "node scripts/kill-metro-port.js && react-native start",
    "build:aab": "cd android && gradlew.bat bundleRelease",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.13.0",
    "@notifee/react-native": "^9.1.5",
    "@react-native-community/blur": "^4.4.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-firebase/app": "^20.5.0",
    "@react-native-firebase/messaging": "^20.5.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/drawer": "^7.1.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.1.18",
    "@reduxjs/toolkit": "^2.3.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "jail-monkey": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-bcrypt": "^2.4.0",
    "react-native-device-info": "^11.1.0",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^3.1.0",
    "react-native-permissions": "^4.1.5",
    "react-native-reanimated": "^4.4.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.6.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.10.2",
    "react-redux": "^9.1.2",
    "victory-native": "^41.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "react-native-dotenv": "^3.4.11",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/__tests__/fixtures.ts"
    ]
  },
  "codegenConfig": {
    "name": "NativeFileDownloadSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.karins"
    }
  }
}
